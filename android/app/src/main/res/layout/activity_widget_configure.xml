<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F7">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CalHabit 월간 위젯 설정"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="홈 화면에 배치할 위젯의 스타일을 설정하세요."
        android:textSize="13sp"
        android:textColor="#6B7280"
        android:layout_marginBottom="16dp" />

    <!-- 실시간 미리보기 카드 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="미리보기"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#4B5563"
        android:layout_marginBottom="6dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:padding="8dp"
        android:background="#2E384D"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:id="@+id/preview_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/widget_card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/preview_month_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2026년 10월"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&lt;  &gt;  +  🔄"
                    android:textSize="12sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="일" android:textColor="#E53935" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="월" android:textColor="#757575" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="화" android:textColor="#757575" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="수" android:textColor="#757575" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="목" android:textColor="#757575" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="금" android:textColor="#757575" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="토" android:textColor="#1E88E5" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- 샘플 일정 칩들 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11" android:textSize="9sp" android:textColor="#E53935" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="신항" android:textSize="7sp" android:textColor="#FFFFFF" android:background="@drawable/widget_chip_color_1" android:padding="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <TextView android:layout_width="16dp" android:layout_height="16dp" android:gravity="center" android:text="12" android:textSize="9sp" android:textColor="#FFFFFF" android:background="@drawable/widget_today_circle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="야간" android:textSize="7sp" android:textColor="#FFFFFF" android:background="@drawable/widget_chip_color_2" android:padding="1dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="광/s" android:textSize="7sp" android:textColor="#FFFFFF" android:background="@drawable/widget_chip_color_3" android:padding="1dp" android:layout_marginTop="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="13" android:textSize="9sp" android:textColor="#212121" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="보컬" android:textSize="7sp" android:textColor="#FFFFFF" android:background="@drawable/widget_chip_color_4" android:padding="1dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_horizontal"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14" android:textSize="9sp" android:textColor="#212121" /></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_horizontal"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15" android:textSize="9sp" android:textColor="#212121" /></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_horizontal"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16" android:textSize="9sp" android:textColor="#212121" /></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_horizontal"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="17" android:textSize="9sp" android:textColor="#1E88E5" /></LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 테마 선택 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="테마 선택"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#374151"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rg_theme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/rb_theme_light"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="라이트 모드"
            android:checked="true"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_theme_dark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="다크 모드"
            android:textSize="14sp" />
    </RadioGroup>

    <!-- 배경 투명도 조절 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="배경 투명도"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#374151" />

        <TextView
            android:id="@+id/tv_opacity_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#2563EB" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/sb_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="90"
        android:layout_marginBottom="24dp" />

    <!-- 하단 확인 / 취소 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="auto">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="취소"
            android:textColor="#4B5563"
            android:backgroundTint="#E5E7EB"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_apply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="위젯 적용"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
